        "_brand_page": {
          "version": 3,
          "body": "<style>\n    *, *::before, *::after {box-sizing: border-box;margin: 0;padding: 0}\n    body {background-color: #f8fafc;color: #0f172a;font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif;line-height: 1.6;-webkit-font-smoothing: antialiased}\n    a {color: inherit;text-decoration: none}\n    .container {max-width: 1140px;margin: 0 auto;padding: 0 24px}\n    \n    /* Hero Section: 左文右信息面板的不对称分栏 */\n    .hero {padding: 64px 0 72px;border-bottom: 1px solid #e2e8f0;background: #ffffff}\n    .hero-split {display: grid;grid-template-columns: 1.35fr 1fr;gap: 48px;align-items: center}\n    .hero-brand-tag {display: inline-block;font-size: 13px;font-weight: 700;letter-spacing: 0.05em;text-transform: uppercase;color: #0891b2;background-color: #ecfeff;border: 1px solid #cffafe;padding: 4px 12px;border-radius: 9999px;margin-bottom: 20px}\n    .hero-text h1 {font-size: 40px;line-height: 1.25;font-weight: 800;color: #0f172a;letter-spacing: -0.02em;margin-bottom: 18px}\n    .hero-text p {font-size: 17px;color: #475569;margin-bottom: 32px;max-width: 540px}\n    \n    /* Nav: 首屏内嵌锚点标签 */\n    .hero-nav {display: flex;flex-wrap: wrap;gap: 12px}\n    .hero-nav a {display: inline-flex;align-items: center;padding: 9px 18px;font-size: 14px;font-weight: 600;color: #334155;background: #f1f5f9;border-radius: 9999px;border: 1px solid #e2e8f0;transition: background-color 0.2s, color 0.2s, border-color 0.2s}\n    .hero-nav a:hover {background-color: #0891b2;color: #ffffff;border-color: #0891b2}\n    \n    /* Hero Right: 状态与规格信息面板 (大圆角软阴影) */\n    .info-panel {background: #ffffff;border-radius: 24px;border: 1px solid #e2e8f0;padding: 32px;box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.08)}\n    .info-panel-header {display: flex;justify-content: space-between;align-items: center;padding-bottom: 20px;border-bottom: 1px solid #f1f5f9;margin-bottom: 20px}\n    .info-panel-title {font-size: 14px;font-weight: 700;color: #0f172a;text-transform: uppercase;letter-spacing: 0.05em}\n    .status-badge {display: inline-flex;align-items: center;gap: 6px;font-size: 12px;font-weight: 600;color: #0891b2}\n    .status-dot {width: 8px;height: 8px;border-radius: 50%;background: #06b6d4}\n    .spec-grid {display: grid;grid-template-columns: 1fr 1fr;gap: 16px}\n    .spec-item {background: #f8fafc;padding: 14px;border-radius: 14px;border: 1px solid #f1f5f9}\n    .spec-label {font-size: 12px;color: #64748b;margin-bottom: 4px}\n    .spec-val {font-size: 15px;font-weight: 700;color: #1e293b}\n\n    /* Common Section */\n    section {padding: 72px 0}\n    .section-head {margin-bottom: 36px}\n    .section-head h2 {font-size: 26px;font-weight: 700;color: #0f172a;letter-spacing: -0.01em;margin-bottom: 6px}\n    .section-head p {font-size: 15px;color: #64748b}\n\n    /* Plans View: 纵向列表逐行展开 (卡片: 大圆角软阴影) */\n    .plans-stack {display: flex;flex-direction: column;gap: 20px}\n    .plan-row {background: #ffffff;border-radius: 20px;border: 1px solid #e2e8f0;box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.05);padding: 28px 32px;display: grid;grid-template-columns: 240px 1fr auto;gap: 32px;align-items: center;transition: border-color 0.2s, box-shadow 0.2s}\n    .plan-row.featured {border: 2px solid #06b6d4;background: #ffffff;box-shadow: 0 16px 35px -8px rgba(8, 145, 178, 0.12);position: relative}\n    .plan-identity {display: flex;flex-direction: column;gap: 6px}\n    .plan-badge {align-self: flex-start;font-size: 11px;font-weight: 700;background: #0891b2;color: #ffffff;padding: 2px 8px;border-radius: 6px;margin-bottom: 4px}\n    .plan-name {font-size: 20px;font-weight: 700;color: #0f172a}\n    .plan-price-block {display: flex;align-items: baseline;gap: 4px}\n    .plan-price {font-size: 24px;font-weight: 800;color: #0891b2}\n    .plan-cycle {font-size: 13px;color: #64748b}\n    .plan-annual {font-size: 13px;color: #475569}\n    .plan-features-list {display: flex;flex-wrap: wrap;gap: 10px 20px;list-style: none}\n    .plan-features-list li {font-size: 14px;color: #334155;display: flex;align-items: center;gap: 8px;min-width: 220px}\n    .plan-features-list li::before {content: \"\";width: 6px;height: 6px;border-radius: 50%;background: #0891b2}\n    .plan-action {display: flex;flex-direction: column;align-items: flex-end}\n    .btn-select {display: inline-block;padding: 10px 24px;font-size: 14px;font-weight: 600;background: #0f172a;color: #ffffff;border-radius: 12px;white-space: nowrap;transition: background 0.2s}\n    .btn-select:hover {background: #0891b2}\n    .plan-row.featured .btn-select {background: #0891b2}\n    .plan-row.featured .btn-select:hover {background: #0e7490}\n\n    /* Workflow & Clients */\n    .steps-grid {display: grid;grid-template-columns: repeat(3, 1fr);gap: 24px}\n    .step-card {background: #ffffff;border-radius: 20px;border: 1px solid #e2e8f0;padding: 28px;box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.04)}\n    .step-num {font-size: 13px;font-weight: 800;color: #0891b2;background: #ecfeff;border: 1px solid #cffafe;width: 32px;height: 32px;display: flex;align-items: center;justify-content: center;border-radius: 8px;margin-bottom: 16px}\n    .step-card h3 {font-size: 17px;font-weight: 700;color: #0f172a;margin-bottom: 8px}\n    .step-card p {font-size: 14px;color: #64748b}\n\n    /* Clients Grid */\n    .clients-card {background: #ffffff;border-radius: 20px;border: 1px solid #e2e8f0;padding: 32px;box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.04)}\n    .clients-list {display: grid;grid-template-columns: repeat(4, 1fr);gap: 16px;margin-top: 24px}\n    .client-box {border: 1px solid #f1f5f9;background: #f8fafc;padding: 20px;border-radius: 14px}\n    .client-os {font-size: 16px;font-weight: 700;color: #0f172a;margin-bottom: 4px}\n    .client-desc {font-size: 13px;color: #64748b;margin-bottom: 12px}\n    .client-status {font-size: 12px;font-weight: 600;color: #0891b2}\n\n    /* FAQ View: 编号列表 (卡片: 大圆角软阴影) */\n    .faq-list {display: flex;flex-direction: column;gap: 16px}\n    .faq-item {background: #ffffff;border-radius: 20px;border: 1px solid #e2e8f0;box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.04);padding: 26px 32px;display: grid;grid-template-columns: 56px 1fr;gap: 20px;align-items: baseline}\n    .faq-index {font-size: 20px;font-weight: 800;color: #0891b2;font-variant-numeric: tabular-nums}\n    .faq-content h3 {font-size: 17px;font-weight: 700;color: #0f172a;margin-bottom: 8px}\n    .faq-content p {font-size: 14px;color: #475569}\n\n    /* Footer */\n    footer {border-top: 1px solid #e2e8f0;padding: 36px 0;background: #ffffff;text-align: center;font-size: 13px;color: #94a3b8}\n\n    /* Responsive */\n    @media (max-width: 900px) {.hero-split {\n        grid-template-columns: 1fr;gap: 36px;}\n      .plan-row {\n        grid-template-columns: 1fr;gap: 20px;}\n      .plan-action {\n        align-items: flex-start;}\n      .steps-grid {\n        grid-template-columns: 1fr;}\n      .clients-list {\n        grid-template-columns: 1fr 1fr;}}\n    @media (max-width: 600px) {\n      .hero-text h1 {font-size: 30px}\n      .spec-grid {grid-template-columns: 1fr}\n      .clients-list {grid-template-columns: 1fr}\n      .faq-item {grid-template-columns: 1fr;gap: 8px}\n    }\n  </style><main>\n  \n  <header class=\"hero\">\n    <div class=\"container\">\n      <div class=\"hero-split\">\n        <div class=\"hero-text\">\n          <span class=\"hero-brand-tag\">KNcloud 网络服务档案</span>\n          <h1>KNcloud 节点订阅与数据路由面板</h1>\n          <p>标准化网络接入中继。按需分配流量额度。支持多终端协议协同。规格公开透明。</p>\n          <nav class=\"hero-nav\" aria-label=\"页面内导航\">\n            <a href=\"#plans\">订阅套餐</a>\n            <a href=\"#guide\">接入流程</a>\n            <a href=\"#clients\">终端支持</a>\n            <a href=\"#faq\">常见问题</a>\n          </nav>\n        </div>\n\n        <div class=\"info-panel\">\n          <div class=\"info-panel-header\">\n            <span class=\"info-panel-title\">系统规格概览</span>\n            <span class=\"status-badge\"><span class=\"status-dot\"></span> 正常分配中</span>\n          </div>\n          <div class=\"spec-grid\">\n            <div class=\"spec-item\">\n              <div class=\"spec-label\">主干通道</div>\n              <div class=\"spec-val\">IPLC 专线与普通节点</div>\n            </div>\n            <div class=\"spec-item\">\n              <div class=\"spec-label\">支持协议</div>\n              <div class=\"spec-val\">通用网络代理核心</div>\n            </div>\n            <div class=\"spec-item\">\n              <div class=\"spec-label\">接入额度</div>\n              <div class=\"spec-val\">100GB - 1000GB</div>\n            </div>\n            <div class=\"spec-item\">\n              <div class=\"spec-label\">设备协同</div>\n              <div class=\"spec-val\">3 至 20 台同时在线</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  \n  <section id=\"plans\">\n    <div class=\"container\">\n      <div class=\"section-head\">\n        <h2>订阅方案</h2>\n        <p>按月结算或按年订购。方案随时切换。无隐性绑定。</p>\n      </div>\n\n      <div class=\"plans-stack\">\n        \n        <article class=\"plan-row\">\n          <div class=\"plan-identity\">\n            <h3 class=\"plan-name\">基础版</h3>\n            <div class=\"plan-price-block\">\n              <span class=\"plan-price\">¥15</span>\n              <span class=\"plan-cycle\">/ 月</span>\n            </div>\n            <span class=\"plan-annual\">按年付仅需 ¥150/年</span>\n          </div>\n          <ul class=\"plan-features-list\">\n            <li>每月 100GB 流量配额</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>普通线路节点池接入</li>\n            <li>基础流媒体内容访问支持</li>\n          </ul>\n          <div class=\"plan-action\">\n            <a href=\"#\" class=\"btn-select\">选用此方案</a>\n          </div>\n        </article>\n\n        \n        <article class=\"plan-row featured\">\n          <div class=\"plan-identity\">\n            <span class=\"plan-badge\">推荐选择</span>\n            <h3 class=\"plan-name\">旗舰版</h3>\n            <div class=\"plan-price-block\">\n              <span class=\"plan-price\">¥35</span>\n              <span class=\"plan-cycle\">/ 月</span>\n            </div>\n            <span class=\"plan-annual\">按年付仅需 ¥350/年</span>\n          </div>\n          <ul class=\"plan-features-list\">\n            <li>每月 300GB 流量配额</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>IPLC 专线路由通道</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n          <div class=\"plan-action\">\n            <a href=\"#\" class=\"btn-select\">选用此方案</a>\n          </div>\n        </article>\n\n        \n        <article class=\"plan-row\">\n          <div class=\"plan-identity\">\n            <h3 class=\"plan-name\">团队版</h3>\n            <div class=\"plan-price-block\">\n              <span class=\"plan-price\">¥85</span>\n              <span class=\"plan-cycle\">/ 月</span>\n            </div>\n            <span class=\"plan-annual\">按年付仅需 ¥850/年</span>\n          </div>\n          <ul class=\"plan-features-list\">\n            <li>每月 1000GB 流量配额</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点池</li>\n            <li>支持企业级定制路由策略</li>\n            <li>专属客户经理跟进服务</li>\n          </ul>\n          <div class=\"plan-action\">\n            <a href=\"#\" class=\"btn-select\">选用此方案</a>\n          </div>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"guide\">\n    <div class=\"container\">\n      <div class=\"section-head\">\n        <h2>配置指引</h2>\n        <p>三步完成接入。纯净配置，无冗余捆绑。</p>\n      </div>\n\n      <div class=\"steps-grid\">\n        <div class=\"step-card\">\n          <div class=\"step-num\">01</div>\n          <h3>选定并获取凭证</h3>\n          <p>根据团队或个人带宽需求订购对应周期方案。进入后台复制标准订阅链接。</p>\n        </div>\n        <div class=\"step-card\">\n          <div class=\"step-num\">02</div>\n          <h3>导入客户端配置</h3>\n          <p>在对应系统客户端中粘贴订阅链接。解析节点列表并完成本地缓存写入。</p>\n        </div>\n        <div class=\"step-card\">\n          <div class=\"step-num\">03</div>\n          <h3>启动分流规则</h3>\n          <p>选取延迟适宜的接入点。开启系统规则分流模式。连接即刻建立。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"clients\">\n    <div class=\"container\">\n      <div class=\"section-head\">\n        <h2>终端与协议兼容性</h2>\n        <p>KNcloud 不分发第三方安装包。用户可通过通用开源内核连接。</p>\n      </div>\n\n      <div class=\"clients-card\">\n        <p>支持所有遵循行业标准通用代理协议的开源工具。导入订阅地址即可使用，请按操作系统自行部署。</p>\n        <div class=\"clients-list\">\n          <div class=\"client-box\">\n            <div class=\"client-os\">Windows</div>\n            <div class=\"client-desc\">支持 Clash / Sing-box 等内核</div>\n            <div class=\"client-status\">标准订阅链接适配</div>\n          </div>\n          <div class=\"client-box\">\n            <div class=\"client-os\">macOS</div>\n            <div class=\"client-desc\">支持 Surge / Clash Verge / Loon</div>\n            <div class=\"client-status\">托管规则直连导入</div>\n          </div>\n          <div class=\"client-box\">\n            <div class=\"client-os\">iOS &amp; iPadOS</div>\n            <div class=\"client-desc\">支持 Shadowrocket / Quantumult X</div>\n            <div class=\"client-status\">扫码或链接一键载入</div>\n          </div>\n          <div class=\"client-box\">\n            <div class=\"client-os\">Android</div>\n            <div class=\"client-desc\">支持 v2rayNG / Clash Meta</div>\n            <div class=\"client-status\">本地配置与策略分流</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"faq\">\n    <div class=\"container\">\n      <div class=\"section-head\">\n        <h2>常见问题</h2>\n        <p>规格与使用说明清单。</p>\n      </div>\n\n      <div class=\"faq-list\">\n        <div class=\"faq-item\">\n          <div class=\"faq-index\">01</div>\n          <div class=\"faq-content\">\n            <h3>配额用尽后服务是否继续提供？</h3>\n            <p>每月流量用尽后传输连接将自动切断。数据额度在下一个自然计费周期首日重置。如需继续使用，可提前在控制台变更高阶方案。</p>\n          </div>\n        </div>\n\n        <div class=\"faq-item\">\n          <div class=\"faq-index\">02</div>\n          <div class=\"faq-content\">\n            <h3>多设备在线数量如何界定？</h3>\n            <p>以并发活跃网络连接的物理设备数量为准。基础版限制 3 台，旗舰版限制 5 台，团队版限制 20 台。超出配额的新设备无法建立通道。</p>\n          </div>\n        </div>\n\n        <div class=\"faq-item\">\n          <div class=\"faq-index\">03</div>\n          <div class=\"faq-content\">\n            <h3>旗舰版的 IPLC 专线路由有何特点？</h3>\n            <p>IPLC 为内网点对点物理通道。不经过公共骨干网常规拥塞节点。网络抖动较低，适合高优先级交互和专有低延迟应用。</p>\n          </div>\n        </div>\n\n        <div class=\"faq-item\">\n          <div class=\"faq-index\">04</div>\n          <div class=\"faq-content\">\n            <h3>是否提供专有封装客户端下载？</h3>\n            <p>KNcloud 不提供自制客户端程序。所有接入均建立在开源协议和成熟的第三方通用网络工具之上。用户可自主掌控本地环境。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n</main>\n\n<footer>\n  <div class=\"container\">\n    <p>© KNcloud. 规格化网络订阅服务面板。按需分配，平稳传输。</p>\n  </div>\n</footer>",
